{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "INR",
          "default": "INR",
          "title": "Currency",
          "type": "string"
        },
        "amount_paise": {
          "minimum": 0,
          "title": "Amount Paise",
          "type": "integer"
        }
      },
      "required": [
        "amount_paise"
      ],
      "title": "Money",
      "type": "object"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/Money"
        },
        "maximum": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "MoneyRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brand_name": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brand Name"
    },
    "business_description": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Business Description"
    },
    "business_model": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Business Model"
    },
    "products_services": {
      "items": {
        "maxLength": 10000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Products Services",
      "type": "array"
    },
    "target_geographies": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "title": "Target Geographies",
      "type": "array"
    },
    "audience_description": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audience Description"
    },
    "primary_objective": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Objective"
    },
    "budget_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "existing_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Existing Asset Ids",
      "type": "array"
    },
    "past_performance": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Past Performance"
    },
    "competitor_names": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "title": "Competitor Names",
      "type": "array"
    },
    "constraints": {
      "items": {
        "maxLength": 10000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "languages": {
      "items": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    }
  },
  "title": "OnboardingInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-intelligence:onboarding-input:1.0"
}
