{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "gap"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "const": 0
              }
            }
          }
        }
      ],
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "fact",
            "inference",
            "assumption",
            "gap"
          ],
          "title": "Classification",
          "type": "string"
        },
        "statement": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "geographic_scope": {
          "enum": [
            "india",
            "global",
            "unknown"
          ],
          "title": "Geographic Scope",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "classification",
        "statement",
        "source_ids",
        "confidence",
        "rationale",
        "geographic_scope"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CopyVariant": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "hook": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Hook",
          "type": "string"
        },
        "body": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "call_to_action": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Call To Action",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "title": "Language",
          "type": "string"
        },
        "status": {
          "const": "draft",
          "default": "draft",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "hook",
        "body",
        "call_to_action",
        "language"
      ],
      "title": "CopyVariant",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "question": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field",
        "question",
        "critical",
        "reason"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GenerationPrompt": {
      "additionalProperties": false,
      "properties": {
        "medium": {
          "enum": [
            "image",
            "video",
            "text"
          ],
          "title": "Medium",
          "type": "string"
        },
        "prompt": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "constraints": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "prohibited_claims": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Prohibited Claims",
          "type": "array"
        }
      },
      "required": [
        "medium",
        "prompt",
        "constraints",
        "prohibited_claims"
      ],
      "title": "GenerationPrompt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "brand_id": {
      "format": "uuid",
      "title": "Brand Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "objective": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "audience": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "channel": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Channel",
      "type": "string"
    },
    "format": {
      "enum": [
        "reel",
        "carousel",
        "static",
        "video",
        "linkedin_post",
        "landing_page",
        "seo_article",
        "email"
      ],
      "title": "Format",
      "type": "string"
    },
    "key_message": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Key Message",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Evidence",
      "type": "array"
    },
    "hooks": {
      "items": {
        "maxLength": 10000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Hooks",
      "type": "array"
    },
    "copy_variants": {
      "items": {
        "$ref": "#/$defs/CopyVariant"
      },
      "title": "Copy Variants",
      "type": "array"
    },
    "visual_direction": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Visual Direction",
      "type": "string"
    },
    "generation_prompts": {
      "items": {
        "$ref": "#/$defs/GenerationPrompt"
      },
      "title": "Generation Prompts",
      "type": "array"
    },
    "test_hypothesis": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Test Hypothesis",
      "type": "string"
    },
    "regulated_category_flags": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "title": "Regulated Category Flags",
      "type": "array"
    },
    "disclosure_required": {
      "title": "Disclosure Required",
      "type": "boolean"
    },
    "upfront_disclosure": {
      "anyOf": [
        {
          "enum": [
            "#Ad",
            "#Sponsored",
            "#Collaboration",
            "#Partnership"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Upfront Disclosure"
    },
    "compliance_checks": {
      "items": {
        "maxLength": 10000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Compliance Checks",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "missing_inputs": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "status": {
      "const": "draft",
      "default": "draft",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "brand_id",
    "plan_id",
    "task_id",
    "objective",
    "audience",
    "channel",
    "format",
    "key_message",
    "evidence",
    "hooks",
    "copy_variants",
    "visual_direction",
    "generation_prompts",
    "test_hypothesis",
    "regulated_category_flags",
    "disclosure_required",
    "upfront_disclosure",
    "compliance_checks",
    "assumptions",
    "missing_inputs"
  ],
  "title": "CreativeBrief",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-intelligence:creative-brief:1.0"
}
