{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "audit_id": {
      "format": "uuid",
      "title": "Audit Id",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "brand_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Brand Id"
    },
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "action": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "entity_type": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Entity Type",
      "type": "string"
    },
    "entity_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entity Id"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "input_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Sha256"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Sha256"
    },
    "source_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Hash"
    },
    "entry_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Entry Hash",
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "organization_id",
    "brand_id",
    "actor_id",
    "action",
    "entity_type",
    "entity_id",
    "request_id",
    "input_sha256",
    "output_sha256",
    "source_ids",
    "error_code",
    "attempt",
    "occurred_at",
    "previous_hash",
    "entry_hash"
  ],
  "title": "AuditLog",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-intelligence:audit-log:1.0"
}
