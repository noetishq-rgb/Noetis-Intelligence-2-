{
  "$defs": {
    "ContextReference": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "fields": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "entity_id",
        "version",
        "fields",
        "sha256"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "INR",
          "default": "INR",
          "title": "Currency",
          "type": "string"
        },
        "amount_paise": {
          "minimum": 0,
          "title": "Amount Paise",
          "type": "integer"
        }
      },
      "required": [
        "amount_paise"
      ],
      "title": "Money",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "token_budget": {
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "token_budget"
      ],
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "brand_id": {
      "format": "uuid",
      "title": "Brand Id",
      "type": "string"
    },
    "workflow_id": {
      "format": "uuid",
      "title": "Workflow Id",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "brand_research",
        "competitor_research",
        "audience_research",
        "market_research",
        "social_listening",
        "content_gap",
        "strategy",
        "strategy_critique",
        "thirty_day_plan",
        "creative_brief",
        "ad_copy",
        "seo_plan",
        "email_sequence",
        "performance",
        "weekly_recommendation",
        "client_report",
        "client_presentation"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "template_id": {
      "format": "uuid",
      "title": "Template Id",
      "type": "string"
    },
    "template_version": {
      "minimum": 1,
      "title": "Template Version",
      "type": "integer"
    },
    "provider": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "input_references": {
      "items": {
        "$ref": "#/$defs/ContextReference"
      },
      "title": "Input References",
      "type": "array"
    },
    "compiled_prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Compiled Prompt Sha256",
      "type": "string"
    },
    "output_schema": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Output Schema",
      "type": "string"
    },
    "output_artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Artifact Id"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "attempt": {
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "valid",
        "invalid",
        "failed",
        "needs_human_review"
      ],
      "title": "Status",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    }
  },
  "required": [
    "run_id",
    "brand_id",
    "workflow_id",
    "task_type",
    "template_id",
    "template_version",
    "provider",
    "model",
    "input_references",
    "compiled_prompt_sha256",
    "output_schema",
    "output_artifact_id",
    "usage",
    "cost",
    "latency_ms",
    "attempt",
    "status",
    "error_code",
    "started_at",
    "finished_at"
  ],
  "title": "PromptRun",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-intelligence:prompt-run:1.0"
}
