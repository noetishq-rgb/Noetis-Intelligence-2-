{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "INR",
          "default": "INR",
          "title": "Currency",
          "type": "string"
        },
        "amount_paise": {
          "minimum": 0,
          "title": "Amount Paise",
          "type": "integer"
        }
      },
      "required": [
        "amount_paise"
      ],
      "title": "Money",
      "type": "object"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/Money"
        },
        "maximum": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "PresenceDraft": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        },
        "platform": {
          "default": "other",
          "enum": [
            "website",
            "instagram",
            "linkedin",
            "facebook",
            "youtube",
            "other"
          ],
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "PresenceDraft",
      "type": "object"
    },
    "ResearchBrief": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "default": "",
          "maxLength": 1000,
          "title": "Question",
          "type": "string"
        },
        "tone_of_voice": {
          "default": "",
          "maxLength": 400,
          "title": "Tone Of Voice",
          "type": "string"
        },
        "guidelines": {
          "default": "",
          "maxLength": 4000,
          "title": "Guidelines",
          "type": "string"
        }
      },
      "title": "ResearchBrief",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brief": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchBrief"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "research_intake_version": {
      "default": 0,
      "enum": [
        0,
        1
      ],
      "title": "Research Intake Version",
      "type": "integer"
    },
    "brand_name": {
      "default": "",
      "maxLength": 300,
      "title": "Brand Name",
      "type": "string"
    },
    "online_presence": {
      "items": {
        "$ref": "#/$defs/PresenceDraft"
      },
      "maxItems": 12,
      "title": "Online Presence",
      "type": "array"
    },
    "category": {
      "default": "",
      "maxLength": 300,
      "title": "Category",
      "type": "string"
    },
    "niche": {
      "default": "",
      "maxLength": 300,
      "title": "Niche",
      "type": "string"
    },
    "objectives": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Objectives",
      "type": "array"
    },
    "other_objective": {
      "default": "",
      "maxLength": 600,
      "title": "Other Objective",
      "type": "string"
    },
    "business_description": {
      "default": "",
      "maxLength": 10000,
      "title": "Business Description",
      "type": "string"
    },
    "audience_description": {
      "default": "",
      "maxLength": 10000,
      "title": "Audience Description",
      "type": "string"
    },
    "target_geographies": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "title": "Target Geographies",
      "type": "array"
    },
    "primary_objective": {
      "default": "",
      "maxLength": 2000,
      "title": "Primary Objective",
      "type": "string"
    },
    "budget_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "SetupDraft",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-intelligence:brain-setup:1.0"
}
