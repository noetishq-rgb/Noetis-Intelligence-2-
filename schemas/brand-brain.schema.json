{
  "$defs": {
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "business",
            "audience",
            "positioning",
            "market",
            "presence",
            "objectives"
          ],
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "key",
        "title",
        "summary",
        "findings"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publisher"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "geographic_scope": {
          "enum": [
            "india",
            "global",
            "unknown"
          ],
          "title": "Geographic Scope",
          "type": "string"
        },
        "applicability_to_india": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applicability To India"
        },
        "access_limitations": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Access Limitations",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "url",
        "publisher",
        "published_at",
        "accessed_at",
        "geographic_scope",
        "applicability_to_india",
        "access_limitations"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "original_text": {
          "title": "Original Text",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "publicly_observed",
            "ai_inferred",
            "founder_provided",
            "founder_confirmed",
            "unverified"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "unknown": {
          "default": false,
          "title": "Unknown",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "field",
        "original_text",
        "text",
        "provenance",
        "confidence",
        "source_ids"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "brand_id": {
      "format": "uuid",
      "title": "Brand Id",
      "type": "string"
    },
    "brand_name": {
      "title": "Brand Name",
      "type": "string"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/Chapter"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Chapters",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "brand_id",
    "brand_name",
    "chapters",
    "sources",
    "warnings"
  ],
  "title": "BrainDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-intelligence:brand-brain:1.0"
}
