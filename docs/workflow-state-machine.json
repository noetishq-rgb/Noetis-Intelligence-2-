    "creating_briefs",
    "planning",
    "preparing_deliverables",
    "researching",
    "reviewing_strategy",
    "strategizing"
  ],
  "resume_targets": {
    "crawling": "crawl_queued",
    "researching": "research_queued",
    "strategizing": "strategy_queued",
    "reviewing_strategy": "red_team_queued",
    "planning": "plan_queued",
    "creating_briefs": "creative_queued",
    "preparing_deliverables": "report_queued"
  },
  "validation_policy": {
    "maximum_invalid_outputs": 2,
    "then": "needs_human_review"
  },
  "job_policy": {
    "max_attempts": 3,
    "crawl_lease_seconds": 120,
    "research_lease_seconds": 900,
    "fenced_completion": true,
    "lost_model_dispatch": "hold_reservation_and_pause_for_human_review"
  },
  "budget_policy": {
    "max_agent_calls": 20,
    "token_budget": 100000,
    "atomic_reservation": true,
    "unknown_usage_is_zero": false,
    "currency": "INR",
    "cost_cap_requires_dated_pricing": true
  },
  "phase1_enabled_stages": [
    "intake",
    "crawl",
    "onboarding",
    "profile_confirmation"
  ],
  "phase2_enabled_stages": [
    "research_collection",
    "research_generation",
    "research_confirmation"
  ],
  "phase2_stop_state": "ready_for_strategy",
  "phase3_validation": {
    "validator_version": "3.0",
    "human_claim_assessment_required": true,
    "provenance_is_semantic_validation": false
  },
  "phase4_enabled_stages": [
    "strategy",
    "strategy_critique",
    "thirty_day_plan",
    "creative_brief"
  ],
  "phase4_stop_state": "ready_for_delivery",
  "phase4_model_calls_default": "disabled",
  "external_execution": false
