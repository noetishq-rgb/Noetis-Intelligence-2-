# Vercel: server-only, restricted API login. Supabase's project/service-role key is NOT a DB URL.
# Copy the host, port and project ref from Supabase > Connect. Use direct or session mode.
MI_DATABASE_URL=postgresql://mi_runtime.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
MI_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MI_ALLOW_SIGNUP=false
MI_ALLOW_MODEL_CALLS=false
MI_ALLOW_PLANNING_CALLS=false
MI_MODEL_PROVIDER=disabled

# Administrator's local/CI environment only, never Vercel or browser variables.
# MI_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# Each GitHub worker job gets its own dedicated bound login and service user UUID.
# MI_WORKER_DATABASE_URL=...
# MI_SERVICE_USER_ID=...
# Configure supported provider keys/model/pricing/cost limits only in GitHub encrypted secrets/variables.
# MI_ANTHROPIC_API_KEY=...
# MI_ANTHROPIC_MODEL=...
# MI_MODEL_INPUT_PAISE_PER_MILLION=...
# MI_MODEL_OUTPUT_PAISE_PER_MILLION=...
# MI_PRICING_AS_OF=YYYY-MM-DD
# MI_RESEARCH_MAX_COST_PAISE=...
